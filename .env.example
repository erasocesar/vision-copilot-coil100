# Copiar a .env y rellenar. Nunca subir .env al repositorio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Precios USD por millón de tokens (OpenAI, 27 oct 2026)
PRICE_INPUT_PER_M=0.40
PRICE_CACHED_PER_M=0.10
PRICE_OUTPUT_PER_M=1.60
# Topes de gasto aplicados en código
DAILY_USD_CAP=1.50
TOTAL_USD_CAP=3.50
MODEL_DIR=models/vision/v1.0.0
IMAGE_DIR=appdata/images
DB_PATH=appdata/line.db
VISION_URL=http://localhost:8001
DEMO_FAULTS=false
# Solo demo: permite elegir rol al abrir sesión (en producción, Entra ID)
DEMO_ROLE_SELECTION=false
# Opcional: aviso de tickets por n8n
N8N_TICKET_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
